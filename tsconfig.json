//Config for storybook and test files

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "stories",
    "packages/**/*.stories.tsx",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.d.ts",
    "testing.tsx",
    ".storybook",
    "global.d.ts"
  ]
}
